# Database
DATABASE_URL="postgresql://user:password@localhost:5432/solar_quotation"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Backend
PORT=4000
NODE_ENV=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public C&I website lead ingest (server-to-server; never expose to browsers)
WEBSITE_LEAD_API_KEY="change-me-website-lead-key"
