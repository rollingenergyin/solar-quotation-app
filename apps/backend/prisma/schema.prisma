generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Roles ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  userId       String     @unique  // Login identifier (e.g. sales01)
  email        String     @unique
  password     String
  name         String
  phone        String?
  designation  String?
  role         Role       @default(SALES)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customers           Customer[]
  quotations          Quotation[]
  formulaVersions     FormulaVersion[]
  weeklyPrices        WeeklyPrice[]
  auditLogs           AuditLog[]
  quotationTemplates  QuotationTemplate[]

  // Attendance
  attendancePolicy      AttendancePolicy?
  attendanceDays        AttendanceDay[]
  attendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectionAdmin")
  leaveRequests         LeaveRequest[]         @relation("LeaveRequestUser")
  leaveApprovals        LeaveRequest[]         @relation("LeaveRequestApprover")
  compOffRequests       CompOffRequest[]       @relation("CompOffUser")
  compOffApprovals      CompOffRequest[]       @relation("CompOffApprover")
  workflowRequests      WorkflowRequest[]      @relation("WorkflowRequester")
  workflowApprovals     WorkflowApproval[]     @relation("WorkflowApprover")
  attendanceNotifications AttendanceNotification[] @relation("AttNotifUser")
  crmLeads                CrmLead[]                @relation("CrmLeadAssignee")

  @@map("users")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  company   String?
  gstin     String?
  notes     String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sites     Site[]
  quotations Quotation[]

  @@map("customers")
}

// ─── Site Details ────────────────────────────────────────────────────────────

enum RoofType {
  FLAT
  SLOPED
  METAL
  TERRACE
  GROUND_MOUNTED
}

model Site {
  id           String    @id @default(cuid())
  customerId   String
  name         String?
  address      String
  city         String?
  state        String?
  pincode      String?
  roofType     RoofType?
  roofAreaSqM  Float?
  orientation  String?   // N, S, E, W, NE, etc.
  tiltAngle    Float?
  latitude     Float?
  longitude    Float?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  electricityBills ElectricityBill[]
  quotations      Quotation[]

  @@map("sites")
}

// ─── OCR Bills & Monthly Units ───────────────────────────────────────────────

enum BillSource {
  MANUAL
  OCR
}

model ElectricityBill {
  id          String    @id @default(cuid())
  siteId      String
  month       Int       // 1-12
  year        Int
  unitsKwh    Float     // monthly consumption
  amount      Float?    // bill amount in rupees
  billImageUrl String?
  ocrRawData  Json?     // raw OCR output for reference
  source      BillSource @default(MANUAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, month, year])
  @@map("electricity_bills")
}

// ─── Materials & Specs ───────────────────────────────────────────────────────

enum MaterialUnit {
  WATT
  PIECE
  METER
  KW
  SET
}

model MaterialCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials Material[]

  @@map("material_categories")
}

model Material {
  id         String       @id @default(cuid())
  categoryId String
  name       String
  brand      String?
  model      String?
  specs      Json?        // { wattage, efficiency, warrantyYears, capacity, etc. }
  unit       MaterialUnit @default(PIECE)
  basePrice  Float?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  category           MaterialCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quotationMaterials QuotationMaterial[]
  weeklyPrices       WeeklyPrice[]

  @@map("materials")
}

// ─── Pricing Types ───────────────────────────────────────────────────────────

model PricingType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  unit        String   // WATT, UNIT, SQ_M, LUMP
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotationPricings QuotationPricing[]

  @@map("pricing_types")
}

// ─── Editable Formulas ───────────────────────────────────────────────────────

model Formula {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions FormulaVersion[]

  @@map("formulas")
}

model FormulaVersion {
  id          String   @id @default(cuid())
  formulaId   String
  expression  String   // e.g. "totalWattage * pricePerWatt"
  variables   Json     // ["totalWattage", "pricePerWatt"]
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  quotationPricings QuotationPricing[]

  @@map("formula_versions")
}

// ─── Quotations ──────────────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  REVIEW
  SENT
  ACCEPTED
  REJECTED
}

enum SystemType {
  DCR
  NON_DCR
}

enum SiteType {
  RESIDENTIAL
  SOCIETY
  COMMERCIAL
  INDUSTRIAL
}

enum QuotationType {
  QUICK
  NORMAL
}

model Quotation {
  id          String          @id @default(cuid())
  customerId  String
  siteId      String
  quoteNumber String          @unique
  status      QuotationStatus  @default(DRAFT)
  systemType        SystemType      @default(DCR)
  siteType          SiteType        @default(RESIDENTIAL)
  sanctionedLoadKw  Float?
  sanctionedLoadIncreasedToKw Float? @map("sanctioned_load_increased_to_kw") // target load after increase (optional)
  inverterSizeKw    Float?
  validUntil        DateTime?
  totalWattage Float?
  totalAmount  Float?
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Saved Quotations System
  quotationType     QuotationType  @default(NORMAL)
  version           Int            @default(1)
  parentQuotationId String?
  quotationDataJson Json?          // Full snapshot for edit/replay
  generatedPdfPath  String?       // Path to stored PDF file
  isPricingLocked   Boolean        @default(false) @map("isPricingLocked")

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdBy  User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  parent     Quotation?  @relation("QuotationVersions", fields: [parentQuotationId], references: [id], onDelete: SetNull)
  versions   Quotation[] @relation("QuotationVersions")
  materials  QuotationMaterial[]
  pricings   QuotationPricing[]
  result     QuotationResult?

  @@map("quotations")
}

// Single row for QT-0001, QT-0002 sequence (id = 'main')
model QuotationSequence {
  id        String   @id @default("main")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
  @@map("quotation_sequence")
}

model QuotationMaterial {
  id           String   @id @default(cuid())
  quotationId  String
  materialId   String
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  specsOverride Json?   // overrides for this line item
  notes        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  material Material   @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("quotation_materials")
}

model QuotationPricing {
  id             String   @id @default(cuid())
  quotationId    String
  pricingTypeId  String
  formulaVersionId String?
  value          Float    // e.g. price per watt
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotation      Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  pricingType    PricingType    @relation(fields: [pricingTypeId], references: [id], onDelete: Restrict)
  formulaVersion FormulaVersion? @relation(fields: [formulaVersionId], references: [id], onDelete: SetNull)

  @@unique([quotationId, pricingTypeId])
  @@map("quotation_pricings")
}

// ─── Weekly Material Pricing ─────────────────────────────────────────────────

model WeeklyPrice {
  id         String   @id @default(cuid())
  materialId String
  pricePerUnit Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes      String?
  createdById String
  createdAt  DateTime @default(now())

  material  Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("weekly_prices")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE | UPDATE | DELETE
  entity     String   // material | formula | pricing | bill
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

// ─── System Parameters ────────────────────────────────────────────────────────

model SystemParam {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  value       Float
  unit        String?
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_params")
}

// ─── Editable Quotation Template ─────────────────────────────────────────────

model QuotationTemplate {
  id      String  @id @default(cuid())
  version Int     @default(1)
  name    String  @default("Default Template")
  isActive Boolean @default(false)
  isDeleted Boolean @default(false)
  isDefaultTemplate Boolean @default(false)

  // Template selection conditions (for automatic matching)
  // systemType: DCR | NON_DCR | ANY (ANY = matches any, e.g. for Commercial/Industrial)
  // siteType: RESIDENTIAL | SOCIETY | COMMERCIAL | INDUSTRIAL | ANY (ANY = fallback)
  systemType String @default("ANY")
  siteType   String @default("ANY")

  // Company branding
  companyName    String  @default("Rolling Energy")
  companyTagline String? @default("Solar EPC Company")
  companyAddress String? @default("2nd Floor, Solar Plaza, Baner Road, Pune 411045, Maharashtra")
  companyPhone   String? @default("+91 98765 43210")
  companyEmail   String? @default("info@rollingenergy.in")
  companyWebsite String? @default("www.rollingenergy.in")

  // Warranty configuration
  panelWarrantyYears Int @default(25)

  // BOM configuration (admin controls)
  bomShowQty  Boolean @default(false)
  bomShowUnit Boolean @default(false)
  bomItems    Json?   // TemplateBomItem[] — null means use system default (legacy / primary option)
  bomOptions  Json?   // deprecated — legacy full-BOM alternatives; use bomItems[].alternatives

  // Subsidy configuration (DCR only)
  subsidyResidential1kw     Float @default(30000)
  subsidyResidential2kw     Float @default(60000)
  subsidyResidential3to10kw Float @default(78000)
  subsidySocietyPerKw       Float @default(18000)

  // Depreciation configuration (Non-DCR systems)
  depreciationNote  String  @default("This solar installation may qualify for accelerated depreciation benefits under applicable tax rules. Assets used for business purposes are eligible for depreciation under the Income Tax Act.")
  depreciationTable Json    // {year:string, rate:string, note:string}[]

  // Editable page content (stored as JSON arrays/objects)
  introLetterBody     Json  // string[]
  aboutParagraphs     Json  // string[]
  aboutMission        String
  aboutStats          Json  // {label:string, value:string}[]
  aboutHighlights     Json  // {icon,title,desc}[]
  processSteps        Json  // {step,title,subtitle,desc,icon,duration}[]
  processTimelineText String @default("Total Timeline: 10–18 Working Days")
  maintenanceServices Json  // {icon,title,desc}[]
  warrantyItems       Json  // {item,warranty}[]
  paymentMilestones   Json  // {step,title,pct,desc,icon}[]
  paymentTermsBullets Json  // string[]
  paymentModes        Json  // {icon,label}[]
  bankDetails         Json? // {accountName,accountNumber,bankName,accountType,ifscCode}
  whyReasons          Json  // {icon,title,desc}[]
  testimonials        Json  // {name,location,text}[]
  certifications      Json  // string[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("quotation_templates")
}

/// Global quotation settings shared across all templates (singleton row id = "default").
model QuotationGlobalSettings {
  id                    String   @id @default("default")
  processTimelineRanges Json     @default("[]")
  updatedAt             DateTime @updatedAt

  @@map("quotation_global_settings")
}

// ─── ROI & EMI Results ───────────────────────────────────────────────────────

model QuotationResult {
  id                  String   @id @default(cuid())
  quotationId         String   @unique
  roiYears            Float?    // years to break even
  roiPercentage       Float?   // annual ROI %
  emiMonthly          Float?
  emiTenureMonths     Int?
  totalSavings        Float?   // lifetime savings estimate
  paybackPeriodMonths Int?
  breakdown           Json?    // { yearlySavings: [], emiSchedule: [] }
  notes               String?
  calculatedAt        DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_results")
}

// ─── Finance Panel (ERP Module) ───────────────────────────────────────────────

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum ExpenseCategory {
  SITE_EXPENSE
  COMMERCIAL_EXPENSE
  SURYAGHAR_LOANS
  OVERHEADS
  MARKETING
  ALLOWANCES
  SALARIES
  FOOD_ACCOMMODATION
  MISC
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  contact   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseBills PurchaseBill[]
  expenses      Expense[]

  @@map("finance_vendors")
}

model FinanceClient {
  id          String   @id @default(cuid())
  name        String
  companyName String?  // billing / legal entity name
  gstin       String?
  contact     String?
  address     String?
  customerId  String?  // link to existing Customer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites       FinanceSite[]
  salesBills   SalesBill[]
  invoices     Invoice[]

  @@map("finance_clients")
}

model FinanceSite {
  id        String   @id @default(cuid())
  name      String
  address   String?
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client            FinanceClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects          FinanceProject[]
  bankTransactions  BankTransaction[]
  transactionSplits  TransactionSplit[]
  transactionRules   TransactionRule[]

  @@map("finance_sites")
}

model FinanceProject {
  id             String   @id @default(cuid())
  name           String
  code           String?  @unique
  financeSiteId  String?
  quotationId    String?
  status         String?  @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  financeSite    FinanceSite? @relation(fields: [financeSiteId], references: [id], onDelete: SetNull)
  expenses       Expense[]
  incomes        Income[]
  purchaseBills   PurchaseBill[]
  salesBills     SalesBill[]
  stockMovements  StockMovement[]

  @@map("finance_projects")
}

model BankStatementUpload {
  id        String   @id @default(cuid())
  fileName  String
  rawData   Json     // original parsed rows
  createdAt DateTime @default(now())

  transactions BankTransaction[]

  @@map("finance_bank_statement_uploads")
}

model TransactionCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  bankTransactions BankTransaction[]
  splits           TransactionSplit[]

  @@map("finance_transaction_categories")
}

enum BankInvoiceTag {
  INV
  NO_INV
}

enum BankBillUploadTag {
  UPLOADED
  NOT_UPLOADED
}

model BankTransaction {
  id                String   @id @default(cuid())
  uploadId          String
  sortOrder         Int      @default(0) @map("sort_order") // manual order within upload (drag-drop)
  transactionDate   DateTime
  valueDate         DateTime?
  referenceNo       String?
  rawDescription    String?  // original from file
  description       String?  // cleaned/parsed description
  partyName         String?
  amount            Float    // always positive; type indicates debit/credit
  type              FinanceTransactionType  // EXPENSE=debit, INCOME=credit
  categoryId        String?  // TransactionCategory (user-manageable)
  siteId            String?  // FinanceSite (all modules link to Site)
  isSplit           Boolean  @default(false)
  isReviewed        Boolean  @default(false)
  duplicateOfId     String?  // if duplicate, points to canonical transaction
  processed         Boolean  @default(false)
  manualOverride    Boolean  @default(false)
  invoiceStatus     BankInvoiceTag? @map("invoice_status")
  billUploadStatus  BankBillUploadTag? @map("bill_upload_status")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  upload       BankStatementUpload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  category     TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  site         FinanceSite?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  duplicateOf  BankTransaction?     @relation("DuplicateOf", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   BankTransaction[]    @relation("DuplicateOf")
  splits       TransactionSplit[]
  purchaseBill PurchaseBill?        @relation("PurchaseBillBankTransaction")
  salesBill    SalesBill?           @relation("SalesBillBankTransaction")

  @@map("finance_bank_transactions")
}

model TransactionSplit {
  id            String   @id @default(cuid())
  transactionId String
  categoryId    String
  siteId        String?
  amount        Float
  description   String?
  invoiceStatus BankInvoiceTag? @map("invoice_status")
  billUploadStatus BankBillUploadTag? @map("bill_upload_status")
  createdAt     DateTime @default(now())

  transaction BankTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    TransactionCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  site        FinanceSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  purchaseBill PurchaseBill?        @relation("PurchaseBillSplitTransaction")
  salesBill    SalesBill?           @relation("SalesBillSplitTransaction")

  @@map("finance_transaction_splits")
}

model TransactionRule {
  id          String   @id @default(cuid())
  name        String?
  priority    Int      @default(0)  // higher = applied first
  conditions  Json     // { partyName?: string, partyNameContains?: string, descriptionContains?: string, ... }
  category    ExpenseCategory?
  siteId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site FinanceSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("finance_transaction_rules")
}

model Expense {
  id          String          @id @default(cuid())
  amount      Float
  category    ExpenseCategory
  siteId      String?
  vendorId    String?
  paymentMode PaymentMode?
  description String?
  billUrl     String?
  multiSite   Boolean         @default(false)
  projectId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendor   Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  project  FinanceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("finance_expenses")
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  category    String?
  siteId      String?
  clientId    String?
  paymentMode PaymentMode?
  description String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project FinanceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("finance_incomes")
}

model PurchaseBill {
  id           String   @id @default(cuid())
  vendorId     String
  projectId    String?
  gstNumber    String?
  invoiceNo    String
  baseAmount   Float
  gstAmount    Float
  totalAmount  Float
  fileUrl      String?
  bankTransactionId String? @unique @map("bank_transaction_id")
  transactionSplitId String? @unique @map("transaction_split_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project          FinanceProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bankTransaction  BankTransaction?   @relation("PurchaseBillBankTransaction", fields: [bankTransactionId], references: [id], onDelete: SetNull)
  transactionSplit TransactionSplit?  @relation("PurchaseBillSplitTransaction", fields: [transactionSplitId], references: [id], onDelete: SetNull)

  @@map("finance_purchase_bills")
}

model SalesBill {
  id           String   @id @default(cuid())
  clientId     String
  projectId    String?
  gstNumber    String?
  invoiceNo    String
  baseAmount   Float
  gstAmount    Float
  totalAmount  Float
  fileUrl      String?
  bankTransactionId String? @unique @map("bank_transaction_id")
  transactionSplitId String? @unique @map("transaction_split_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client           FinanceClient      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project          FinanceProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bankTransaction  BankTransaction?   @relation("SalesBillBankTransaction", fields: [bankTransactionId], references: [id], onDelete: SetNull)
  transactionSplit TransactionSplit?  @relation("SalesBillSplitTransaction", fields: [transactionSplitId], references: [id], onDelete: SetNull)

  @@map("finance_sales_bills")
}

// Tax / Proforma / Quotation / E-Way — numbering is per main kind.
enum InvoiceMainKind {
  TAX_INVOICE
  PROFORMA_INVOICE
  QUOTATION
  EWAY_BILL
}

// SPGS vs line-item modes — templates are one per subtype (3 total).
enum InvoiceSubtype {
  SPGS
  SERVICE
  PRODUCT
}

model InvoiceTemplate {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  subtype   InvoiceSubtype
  // One active template per subtype — used when creating invoices of that type.
  isActive  Boolean        @default(false) @map("is_active")
  config    Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  invoices Invoice[]

  @@index([subtype])
  @@map("finance_invoice_templates")
}

model FinanceInvoiceSequence {
  mainKind   InvoiceMainKind @id @map("main_kind")
  prefix     String          @default("")
  lastNumber Int             @default(0) @map("last_number")
  updatedAt  DateTime       @updatedAt

  @@map("finance_invoice_sequences")
}

model Invoice {
  id              String          @id @default(cuid())
  mainKind        InvoiceMainKind   @map("main_kind")
  subtype         InvoiceSubtype
  clientId        String
  quotationId     String?
  items           Json
  totalAmount     Float
  fileUrl         String?
  invoiceNumber   String?         @map("invoice_number")
  invoiceDate     DateTime?       @map("invoice_date")
  templateId      String?         @map("template_id")
  deletedAt       DateTime?       @map("deleted_at")
  convertedFromId String?         @map("converted_from_id")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client          FinanceClient    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template        InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  convertedFrom   Invoice?         @relation("InvoiceConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo     Invoice[]        @relation("InvoiceConversion")

  @@map("finance_invoices")
}

enum ProductType {
  SPGS
  EXTERNAL
}

model FinanceProduct {
  id       String      @id @default(cuid())
  name     String
  hsn      String?
  type     ProductType @default(SPGS)
  createdAt DateTime   @default(now())
  updatedAt DateTime  @updatedAt

  stockMovements StockMovement[]

  @@map("finance_products")
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  projectId  String?
  siteId     String?
  quantity   Float    // + for purchase, - for usage
  unitPrice  Float?
  type       String   // PURCHASE | USAGE
  createdAt  DateTime @default(now())

  product  FinanceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  project  FinanceProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("finance_stock_movements")
}

model CashVoucher {
  id           String   @id @default(cuid())
  amount       Float
  description  String?
  category     String?
  paymentSource String?
  billUrl      String?
  createdAt    DateTime @default(now())

  @@map("finance_cash_vouchers")
}

model CashflowSnapshot {
  id              String   @id @default(cuid())
  date            DateTime
  openingBalance  Float
  inflows         Float
  outflows        Float
  closingBalance  Float
  createdAt       DateTime @default(now())

  @@map("finance_cashflow_snapshots")
}

// ─── Attendance System ──────────────────────────────────────────────────────

enum AttendanceStatus {
  NONE
  IN_PROGRESS
  COMPLETE
  ABSENT
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  PLANNED
  EMERGENCY
  SICK
  CASUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CompOffStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

enum WorkflowType {
  PRICING
  DISCOUNT
  COMPLAINT
  OTHER
}

enum WorkflowStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

model AttendancePolicy {
  id                   String   @id @default(cuid())
  // null = global policy; set = per-employee override
  userId               String?  @unique
  workStartTime        String   @default("09:30") // HH:mm
  workEndTime          String   @default("18:30") // HH:mm
  graceMinutes         Int      @default(15)
  lateAfterMinutes     Int      @default(30)
  sundayCompOffAuto    Boolean  @default(true)
  effectiveFrom        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendance_policy")
}

model AttendanceDay {
  id           String           @id @default(cuid())
  userId       String
  date         String           // YYYY-MM-DD local date
  status       AttendanceStatus @default(NONE)
  isLate       Boolean          @default(false)
  lateMinutes  Int              @default(0)
  isSunday     Boolean          @default(false)
  // Daily log — can be filled any time same day (before/after checkout)
  dailyUpdate  String?
  tomorrowPlan String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn     AttendanceCheckIn?
  checkOut    AttendanceCheckOut?
  corrections AttendanceCorrection[]
  compOff     CompOffRequest?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance_days")
}

model AttendanceCheckIn {
  id               String   @id @default(cuid())
  attendanceDayId  String   @unique
  capturedAt       DateTime // server UTC
  clientCapturedAt DateTime?
  selfieKey        String   // storage key (local disk or S3)
  selfieHash       String?  // SHA-256 for dedup
  lat              Float?
  lng              Float?
  accuracyM        Float?
  description      String
  workLocation     String?  // OFFICE | ON_FIELD
  deviceInfo       String?
  syncBatchId      String?  // for offline sync
  createdAt        DateTime @default(now())

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@map("attendance_check_ins")
}

model AttendanceCheckOut {
  id               String   @id @default(cuid())
  attendanceDayId  String   @unique
  capturedAt       DateTime
  clientCapturedAt DateTime?
  selfieKey        String?
  lat              Float?
  lng              Float?
  accuracyM        Float?
  description      String   // short description at checkout (mandatory)
  workLocation     String?  // OFFICE | ON_FIELD
  fullDayUpdate    String?  // detailed update — filled via daily log (optional)
  nextDayPlan      String?  // tomorrow's plan — filled via daily log (optional)
  syncBatchId      String?
  createdAt        DateTime @default(now())

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@map("attendance_check_outs")
}

model AttendanceCorrection {
  id              String   @id @default(cuid())
  attendanceDayId String
  adminId         String
  fieldChanged    String
  oldValue        String?
  newValue        String?
  reason          String
  createdAt       DateTime @default(now())

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  admin         User          @relation("AttendanceCorrectionAdmin", fields: [adminId], references: [id])

  @@index([attendanceDayId])
  @@map("attendance_corrections")
}

model LeaveRequest {
  id                   String      @id @default(cuid())
  userId               String
  startDate            String      // YYYY-MM-DD
  endDate              String      // YYYY-MM-DD
  type                 LeaveType
  reason               String
  status               LeaveStatus @default(PENDING)
  approverId           String?
  decidedAt            DateTime?
  emergencyJustification String?
  advanceDaysSatisfied Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user     User  @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("LeaveRequestApprover", fields: [approverId], references: [id])

  @@index([userId])
  @@map("leave_requests")
}

model CompOffRequest {
  id              String        @id @default(cuid())
  userId          String
  workDate        String        // YYYY-MM-DD (Sunday or extra day)
  attendanceDayId String?       @unique
  status          CompOffStatus @default(PENDING)
  approverId      String?
  decidedAt       DateTime?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation("CompOffUser", fields: [userId], references: [id], onDelete: Cascade)
  approver      User?          @relation("CompOffApprover", fields: [approverId], references: [id])
  attendanceDay AttendanceDay? @relation(fields: [attendanceDayId], references: [id])

  @@index([userId])
  @@map("comp_off_requests")
}

model WorkflowRequest {
  id          String         @id @default(cuid())
  type        WorkflowType
  requesterId String
  title       String
  description String
  payload     Json?
  status      WorkflowStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  requester User               @relation("WorkflowRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approvals WorkflowApproval[]

  @@index([requesterId])
  @@map("workflow_requests")
}

model WorkflowApproval {
  id         String    @id @default(cuid())
  requestId  String
  approverId String
  decision   String    // APPROVED | REJECTED | COMMENT
  comment    String?
  decidedAt  DateTime  @default(now())

  request  WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User            @relation("WorkflowApprover", fields: [approverId], references: [id])

  @@map("workflow_approvals")
}

model AttendanceNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // CHECKIN_REMINDER | LATE | CHECKOUT_REMINDER | MISSING | LEAVE_DECIDED | COMPOFF_DECIDED | WORKFLOW_UPDATE
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation("AttNotifUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attendance_notifications")
}

// ─── Solar Growth OS ─────────────────────────────────────────────────────────

// ── Phase 1: CRM State Machine ───────────────────────────────────────────────

enum CrmStage {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_DONE
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  DISQUALIFIED
}

enum LeadSource {
  MANUAL
  WHATSAPP
  SHEET_IMPORT
  API
  WEBSITE
  REFERRAL
  CAMPAIGN
}

enum LeadLanguage {
  EN
  HI
  MR
}

model CrmLead {
  id           String       @id @default(cuid())
  phone        String       @unique
  phoneHash    String       @unique
  email        String?
  name         String
  source       LeadSource   @default(MANUAL)
  language     LeadLanguage @default(EN)
  stage        CrmStage     @default(NEW)
  score        Int          @default(0)
  assignedToId String?
  customerId   String?      // link to existing Customer once converted
  metadata     Json         @default("{}")
  notes        String?
  city         String?
  state        String?
  systemKw     Float?       // desired system size
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedTo   User?           @relation("CrmLeadAssignee", fields: [assignedToId], references: [id])
  events       CrmLeadEvent[]
  score_record CrmLeadScore?
  conversations CrmConversation[]
  campaignEnrollments CampaignEnrollment[]

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
  @@index([score])
  @@map("crm_leads")
}

model CrmLeadEvent {
  id          String   @id @default(cuid())
  leadId      String
  eventType   String   // LEAD_CREATED | STAGE_CHANGED | MESSAGE_SENT | SCORE_UPDATED | NOTE_ADDED | etc.
  fromStage   String?
  toStage     String?
  actor       String   // user_id | 'system' | 'automation:{rule_id}'
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  lead        CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("crm_lead_events")
}

model CrmLeadScore {
  leadId          String   @id
  score           Int      @default(0)
  recencyScore    Int      @default(0)
  engagementScore Int      @default(0)
  fitScore        Int      @default(0)
  calculatedAt    DateTime @default(now())

  lead            CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("crm_lead_scores")
}

// ── Phase 2: Automation Engine ───────────────────────────────────────────────

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  trigger     Json     // { "event": "lead.stage_changed", "filter": { "toStage": "CONTACTED" } }
  conditions  Json     @default("[]") // [{ "field": "lead.score", "op": "gte", "value": 50 }]
  actions     Json     // [{ "type": "send_whatsapp", "templateId": "...", "delayMinutes": 0 }]
  loopGuard   Int      @default(1)  // max executions per lead per 24h
  priority    Int      @default(0)  // lower = runs first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  AutomationExecution[]

  @@map("automation_rules")
}

model AutomationExecution {
  id             String   @id @default(cuid())
  ruleId         String
  leadId         String
  triggerEventId String
  status         String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED
  attempts       Int      @default(0)
  result         Json     @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, leadId, triggerEventId]) // idempotency key
  @@index([leadId])
  @@index([status])
  @@map("automation_executions")
}

// ── Phase 3: Multilingual Templates ─────────────────────────────────────────

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   // welcome | follow_up | proposal | payment_reminder | qualification
  channel     String   // whatsapp | email | sms | voice
  contentEn   String
  contentHi   String?
  contentMr   String?
  variables   String[] @default([]) // ['name', 'kw_size', 'price']
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, channel])
  @@map("message_templates")
}

// ── Phase 4: Communication Engine ────────────────────────────────────────────

model CrmConversation {
  id            String   @id @default(cuid())
  leadId        String
  channel       String   // whatsapp | email | sms
  lastMessageAt DateTime?
  context       Json     @default("[]")  // last 20 messages for AI context
  intent        String?  // current detected intent
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lead          CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages      CrmMessage[]

  @@unique([leadId, channel])
  @@map("crm_conversations")
}

model CrmMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   // INBOUND | OUTBOUND
  channel        String
  content        String
  language       String   @default("en")
  status         String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  externalId     String?  // WhatsApp message ID / email ID
  metadata       Json     @default("{}")
  sentAt         DateTime @default(now())

  conversation   CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt(sort: Desc)])
  @@map("crm_messages")
}

// ── Phase 5: Sheet Ingestion ──────────────────────────────────────────────────

model SheetImport {
  id          String   @id @default(cuid())
  filename    String
  totalRows   Int      @default(0)
  imported    Int      @default(0)
  duplicates  Int      @default(0)
  failed      Int      @default(0)
  status      String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  errorReport Json     @default("[]")
  importedBy  String
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@map("sheet_imports")
}

// ── Phase 6: Campaign Engine ──────────────────────────────────────────────────

enum CampaignType {
  BROADCAST
  DRIP
  BEHAVIORAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  type         CampaignType
  status       CampaignStatus @default(DRAFT)
  channel      String         // whatsapp | email | sms
  targetFilter Json           @default("{}") // { "stage": "PROPOSAL_SENT", "score_gte": 40 }
  templateId   String?
  scheduledAt  DateTime?
  sentCount    Int            @default(0)
  openCount    Int            @default(0)
  replyCount   Int            @default(0)
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  steps        DripStep[]
  enrollments  CampaignEnrollment[]

  @@index([status, scheduledAt])
  @@map("campaigns")
}

model DripStep {
  id          String   @id @default(cuid())
  campaignId  String
  stepNumber  Int
  delayDays   Int
  templateId  String
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@map("drip_steps")
}

model CampaignEnrollment {
  id          String   @id @default(cuid())
  campaignId  String
  leadId      String
  currentStep Int      @default(0)
  nextSendAt  DateTime?
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | UNSUBSCRIBED | STOPPED
  stoppedAt   DateTime?
  stopReason  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([status, nextSendAt])
  @@map("campaign_enrollments")
}

// ── Phase 8: Analytics Engine ─────────────────────────────────────────────────

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  date      DateTime // truncated to date
  metric    String   // leads_created | stage_conversions | messages_sent | campaign_sent
  dimension String?  // source | stage | channel | rep_id | campaign_id
  value     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([date, metric, dimension])
  @@index([date, metric])
  @@map("analytics_snapshots")
}

// ── Phase 10: Social Media Automation ────────────────────────────────────────

enum SocialSegment {
  RESIDENTIAL
  SOCIETY
  COMMERCIAL
  INDUSTRIAL
  GROUND_MOUNT
}

enum SocialContentType {
  STATIC_POST
  CAROUSEL
  REEL
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  POSTED
  FAILED
}

model SocialPost {
  id            String            @id @default(cuid())
  title         String
  segment       SocialSegment
  contentType   SocialContentType
  status        SocialPostStatus  @default(DRAFT)
  captionEn     String
  captionHi     String
  captionMr     String
  hashtags      String[]
  visualConcept String
  mediaUrl      String?
  platforms     String[]          @default(["instagram", "facebook"])
  scheduledAt   DateTime?
  postedAt      DateTime?
  isNewsSlot      Boolean           @default(false)
  rejectionNote   String?
  productionSpec  Json?
  currentVersion  Int               @default(1)
  slotId          String?           @unique
  slot            SocialCalendarSlot? @relation(fields: [slotId], references: [id])
  analytics       SocialPostAnalytics?
  versions        SocialPostVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([segment, contentType])
  @@map("social_posts")
}

model SocialPostVersion {
  id         String     @id @default(cuid())
  postId     String
  post       SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  version    Int
  label      String     // "AI Generated" | "User Edit" | "Final Approved" | "Rejected"
  snapshot   Json
  editedBy   String?
  changeNote String?
  createdAt  DateTime   @default(now())

  @@unique([postId, version])
  @@index([postId])
  @@map("social_post_versions")
}

model SocialCalendarSlot {
  id         String    @id @default(cuid())
  date       DateTime
  slotType   String    // PLANNED | NEWS_SLOT | FESTIVAL | SEASONAL
  theme      String
  segment    String?
  isNewsSlot Boolean   @default(false)
  post       SocialPost?
  createdAt  DateTime  @default(now())

  @@index([date])
  @@map("social_calendar_slots")
}

model SocialPlatformCredential {
  id           String    @id @default(cuid())
  platform     String    // instagram | linkedin | facebook
  displayName  String
  accessToken  String
  refreshToken String?
  pageId       String?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([platform])
  @@map("social_platform_credentials")
}

model SocialPostAnalytics {
  id        String     @id @default(cuid())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String     @unique
  platform  String
  likes     Int        @default(0)
  comments  Int        @default(0)
  shares    Int        @default(0)
  reach     Int        @default(0)
  clicks    Int        @default(0)
  fetchedAt DateTime   @default(now())

  @@map("social_post_analytics")
}
