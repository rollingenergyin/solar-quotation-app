{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "tsc:version": "tsc --version",
    "build": "node -e \"console.log('--- Build env ---'); console.log('Node:', process.version); console.log('Platform:', process.platform);\" && tsc --version && prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:fix-company-column": "prisma db execute --file ./scripts/sql/add_finance_client_company_name.sql",
    "db:add-invoice-columns": "prisma db execute --file ./prisma/migrations/20260328180000_add_invoice_document_columns/migration.sql",
    "db:apply-invoice-templates": "prisma db execute --file ./prisma/migrations/20260328120000_invoice_templates/migration.sql",
    "db:apply-invoice-soft-delete": "prisma db execute --file ./prisma/migrations/20260329120000_invoice_soft_delete/migration.sql",
    "db:apply-invoice-template-types": "prisma db execute --file ./prisma/migrations/20260329140000_invoice_template_per_type/migration.sql",
    "db:apply-invoice-main-kind": "prisma db execute --file ./prisma/migrations/20260329160000_invoice_main_kind_subtype/migration.sql",
    "db:apply-bank-sort-order": "prisma db execute --file ./prisma/migrations/20260329120001_bank_transaction_sort_order/migration.sql",
    "db:apply-bank-bill-links": "prisma db execute --file ./prisma/migrations/20260329190000_bank_transaction_bill_links/migration.sql",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "create-admin": "tsx scripts/createAdmin.ts",
    "create-finance-user": "tsx scripts/createFinanceUser.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expr-eval": "^2.0.2",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^5.5.207",
    "puppeteer": "^23.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
